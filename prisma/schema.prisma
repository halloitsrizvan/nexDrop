generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  SHOP_OWNER
  CUSTOMER
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ShopMemberRole {
  OWNER
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_PICKUP
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  REFUNDED
}

enum OrderChannel {
  ONLINE
  POS
}

enum PaymentMethod {
  COD
  CASH
  UPI
  CARD
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  RECORDED
  FAILED
  REFUNDED
}

enum StockMovementType {
  ADDED
  DEDUCTED
  ADJUSTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  phone         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  ownedShops       Shop[]            @relation("ShopOwner")
  memberships      ShopMember[]
  customerProfile  CustomerProfile?
  addresses        Address[]
  carts            Cart[]
  wishlists        Wishlist[]
  orders           Order[]           @relation("CustomerOrders")
  posOrders        Order[]           @relation("PosCashier")
  reviews          Review[]
  returnRequests   ReturnRequest[]
  activityLogs     ActivityLog[]
  stockMovements   StockMovement[]
}

model Shop {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  logo        String?
  description String?    @db.Text
  status      ShopStatus @default(PENDING)
  ownerId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner          User            @relation("ShopOwner", fields: [ownerId], references: [id])
  members        ShopMember[]
  settings       ShopSettings?
  categories     Category[]
  products       Product[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  orders         Order[]
  coupons        Coupon[]
  reviews        Review[]
  subscriptions  Subscription[]
  activityLogs   ActivityLog[]
  carts          Cart[]
  wishlists      Wishlist[]
  returnRequests ReturnRequest[]

  @@index([status])
  @@index([ownerId])
}

model ShopMember {
  id        String         @id @default(cuid())
  userId    String
  shopId    String
  role      ShopMemberRole @default(OWNER)
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId])
}

model ShopSettings {
  id                 String   @id @default(cuid())
  shopId             String   @unique
  contactNumber      String?
  email              String?
  address            String?
  city               String?
  state              String?  @default("Kerala")
  pinCode            String?
  businessCategory   String?
  openingHours       String?
  deliveryEnabled    Boolean  @default(true)
  pickupEnabled      Boolean  @default(true)
  deliveryCharge     Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryAbove  Decimal? @db.Decimal(12, 2)
  minOrderValue      Decimal  @default(0) @db.Decimal(12, 2)
  serviceablePins    String[] @default([])
  storeOpen          Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  priceMonthly  Decimal  @db.Decimal(12, 2)
  description   String?
  features      String[] @default([])
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id         String             @id @default(cuid())
  shopId     String
  planId     String
  status     SubscriptionStatus @default(TRIAL)
  startedAt  DateTime           @default(now())
  renewsAt   DateTime?
  createdAt  DateTime           @default(now())

  shop Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([shopId])
}

model Category {
  id        String   @id @default(cuid())
  shopId    String
  name      String
  slug      String
  createdAt DateTime @default(now())

  shop     Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([shopId, slug])
  @@index([shopId])
}

model Product {
  id            String        @id @default(cuid())
  shopId        String
  categoryId    String?
  name          String
  description   String?       @db.Text
  sku           String
  brand         String?
  price         Decimal       @db.Decimal(12, 2)
  discountPrice Decimal?      @db.Decimal(12, 2)
  images        String[]      @default([])
  status        ProductStatus @default(ACTIVE)
  featured      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  shop       Shop             @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  inventory  Inventory?
  cartItems  CartItem[]
  wishItems  WishlistItem[]
  orderItems OrderItem[]
  reviews    Review[]

  @@unique([shopId, sku])
  @@index([shopId, name])
  @@index([shopId, brand])
  @@index([shopId, status])
  @@index([categoryId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  shopId    String
  name      String
  sku       String
  size      String?
  color     String?
  price     Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([shopId, sku])
  @@index([productId])
}

model Inventory {
  id          String   @id @default(cuid())
  shopId      String
  productId   String   @unique
  variantId   String?  @unique
  quantity    Int      @default(0)
  lowStockAt  Int      @default(5)
  updatedAt   DateTime @updatedAt

  shop     Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  movements StockMovement[]

  @@index([shopId, quantity])
}

model StockMovement {
  id          String             @id @default(cuid())
  shopId      String
  inventoryId String
  type        StockMovementType
  quantity    Int
  reason      String
  orderId     String?
  userId      String?
  createdAt   DateTime           @default(now())

  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([inventoryId])
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  line1     String
  line2     String?
  city      String
  state     String   @default("Kerala")
  pinCode   String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  shopId    String
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop  Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId, shopId])
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int    @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([cartId, productId, variantId])
}

model Wishlist {
  id     String @id @default(cuid())
  userId String
  shopId String

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop  Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items WishlistItem[]

  @@unique([userId, shopId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
}

model Order {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  shopId          String
  customerId      String?
  cashierId       String?
  addressId       String?
  channel         OrderChannel
  status          OrderStatus  @default(PENDING)
  subtotal        Decimal      @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  deliveryCharge  Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  couponCode      String?
  notes           String?
  fulfillmentNote String?
  stockDeducted   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  shop      Shop                 @relation(fields: [shopId], references: [id])
  customer  User?                @relation("CustomerOrders", fields: [customerId], references: [id])
  cashier   User?                @relation("PosCashier", fields: [cashierId], references: [id])
  address   Address?             @relation(fields: [addressId], references: [id])
  items     OrderItem[]
  history   OrderStatusHistory[]
  payment   Payment?
  returns   ReturnRequest[]

  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([customerId])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  name        String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  shopId    String
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model Coupon {
  id         String     @id @default(cuid())
  shopId     String
  code       String
  type       CouponType
  value      Decimal    @db.Decimal(12, 2)
  minOrder   Decimal    @default(0) @db.Decimal(12, 2)
  active     Boolean    @default(true)
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, code])
}

model Review {
  id        String   @id @default(cuid())
  shopId    String
  productId String
  userId    String
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  shop    Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model ReturnRequest {
  id        String   @id @default(cuid())
  shopId    String
  orderId   String
  userId    String
  reason    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shopId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  shopId    String?
  userId    String?
  action    String
  meta      String?
  createdAt DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
}

model PlatformSetting {
  id    String @id @default("platform")
  key   String @unique
  value String @db.Text
}
